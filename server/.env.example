PORT=4000
NODE_ENV=development

# MongoDB connection string. For transaction support (used by the registration
# endpoint) this must point at a replica set - a local single-node replica set
# works fine for development. See README for setup instructions.
MONGODB_URI=mongodb://127.0.0.1:27017/feedants?replicaSet=rs0

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Comma separated list of origins allowed to call the API
CORS_ORIGIN=*

# Max upload size for submissions, in bytes (default 50MB)
MAX_UPLOAD_BYTES=52428800

# Demo/seed account credentials (development only)
SEED_DEMO_EMAIL=demo@feedants.com
SEED_DEMO_PASSWORD=Demo@1234
